# Copy to .env inside zax-app. Never commit .env or real credentials.
# Required: create an empty MySQL database first. URL-encode credentials.
DATABASE_URL=
# Required: values issued by your Manus/OAuth provider (not invented local keys).
MANUS_PROJECT_ID=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
# Required: stable random secret, at least 32 bytes. Also protects encrypted data.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANUS_JWT_SECRET=

# Development API. Use a reachable HTTPS URL for devices/remote previews.
# For same-origin production web hosting, leave EXPO_PUBLIC_API_BASE_URL empty at build time.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
PORT=3000
# Optional trusted preview origins, without paths or trailing slashes.
EXPO_PACKAGER_PROXY_URL=
EXPO_WEB_PREVIEW_URL=
# Optional deployed HTTPS origin used by CORS and OAuth redirects.
PUBLIC_APP_URL=
# Legacy/deployment origin aliases, if your host uses them.
STRATDESK_APP_ORIGIN=
MANUS_ADDON_RUNTIME_PUBLIC_ORIGIN=

# Server-only optional AI, file storage, and notification services.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional market data providers. No live broker order execution is enabled.
FMP_API_KEY=
FMP_CHART_TIMEZONE=America/New_York
TRADELOCKER_ENVIRONMENT=demo
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_OWNER_EMAIL=

# Created by pnpm run setup; on Windows use .venv/Scripts/python.exe.
# An externally managed Python 3.11+ executable may be used instead.
PYTHON_EXECUTABLE=.venv/bin/python
