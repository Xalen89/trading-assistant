# Copy to server/.env. Never commit server/.env.
HOST=127.0.0.1
PORT=3001
# Unset = explicit in-memory demo with synthetic candles.
DATABASE_URL=
# Optional shared bearer token, applied to EVERY /api route including health.
API_TOKEN=
# Required for price data when DATABASE_URL is set.
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice
OANDA_NAS100_INSTRUMENT=NAS100_USD
OANDA_XAUUSD_INSTRUMENT=XAU_USD
# Optional. If set, provider failures produce 502; never a silent demo fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
