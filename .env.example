# With no DATABASE_URL, data is ephemeral and resets when the API restarts.
DATABASE_URL=
HOST=127.0.0.1
PORT=4000
# Set the same API_TOKEN in web/.env.local if enabling API authentication.
API_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
# OANDA account token; prices are synthetic demo candles when this is unset.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
OANDA_NAS100_INSTRUMENT=NAS100_USD
OANDA_XAUUSD_INSTRUMENT=XAU_USD
