{
  "name": "trading-assistant",
  "version": "1.0.0",
  "description": "A web app for trading NAS100 and XAUUSD with AI scenario data visualization on charts",
  "private": true,
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc -p server/tsconfig.json && npm --prefix web run build",
    "start": "tsx server/index.ts",
    "start:web": "npm --prefix web run start",
    "test": "tsx --test server/*.test.ts tests/*.test.ts",
    "typecheck": "tsc -p server/tsconfig.json",
    "lint": "npm --prefix web run lint",
    "db:migrate": "tsx server/migrate.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xalen89/trading-assistant.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
